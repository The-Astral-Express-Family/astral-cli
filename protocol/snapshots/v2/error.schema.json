{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/The-Astral-Express-Family/astral-modulator/main/api/schemas/error.json",
  "title": "Astral Error Envelope",
  "description": "所有非 2xx JSON 响应的统一形状（wire 语义见 docs/protocol.md 错误 envelope 一节）。服务端 internal/httpx/errors.go 必须与此同步。",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "request_id": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "TOKEN_EXPIRED",
        "TOKEN_REVOKED",
        "INSUFFICIENT_SCOPE",
        "SERVER_NOT_FOUND",
        "WORKSPACE_NOT_FOUND",
        "WORKSPACE_ALREADY_BOUND",
        "WORKSPACE_NAME_TAKEN",
        "TASK_NOT_FOUND",
        "TASK_ALREADY_CLAIMED",
        "TASK_LEASE_EXPIRED",
        "TAG_PROPOSAL_EXPIRED",
        "TAG_ALREADY_EXISTS",
        "APPROVAL_EXPIRED",
        "INVITE_INVALID",
        "ALREADY_MEMBER",
        "EMAIL_TAKEN",
        "REVISION_CONFLICT",
        "DOCUMENT_CONFLICT",
        "RATE_LIMITED",
        "CLIENT_VERSION_UNSUPPORTED",
        "VALIDATION_FAILED",
        "NOT_FOUND",
        "AUTHORIZATION_PENDING",
        "SLOW_DOWN",
        "INTERNAL_ERROR"
      ],
      "notes": "AUTHORIZATION_PENDING/SLOW_DOWN 为 device flow 轮询语义（A1，RFC 8628，HTTP 400 + retryable）。NOT_FOUND 用于未知路由与无专用码的次级资源 404。APPROVAL_EXPIRED 为 approval 状态机裁决语义（architecture §22）。INVITE_INVALID 对邀请码失效（含错轨：工作区码进注册/注册码进 redeem）统一同码同文案（防探测，ADR-0009）；ALREADY_MEMBER 为兑码入伙时已是该 workspace 成员（409，码不消耗）；EMAIL_TAKEN 仅在注册码验证通过后可达（docs/registration.md）"
    }
  }
}
