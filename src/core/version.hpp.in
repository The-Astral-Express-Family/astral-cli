#pragma once

#include <nlohmann/json_fwd.hpp>

#include <string>

namespace astral::core {

inline constexpr const char* kProjectName = "astral";
inline constexpr const char* kProjectVersion = "@PROJECT_VERSION@";
inline constexpr const char* kGitDescribe = "@ASTRAL_GIT_DESCRIBE@";

// Protocol version this CLI speaks; see ARCHITECTURE.md section 5.
inline constexpr int kProtocolVersion = 1;

const char* buildPlatform();

// CLI 身份信息的单一来源：version/doctor 命令与 --version 回退共用，
// 字段增改只改 version.cpp 一处（此前三处手拼，git 字段已经漂移丢失过）。
// 人类可读单行："astral <version> (<git>, <platform>, protocol <N>)"。
std::string identityString();
// JSON 身份字段：{name?, version, git, platform, protocolVersion}。
nlohmann::json identityFields(bool withName);

}  // namespace astral::core
